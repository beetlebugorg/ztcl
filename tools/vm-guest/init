#!/bin/busybox sh
# The first process of the spike guest of ztcl::vm (ztcl#203).
/bin/busybox --install -s /bin
mkdir -p /proc /sys /dev /tmp /mnt/share
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mount -t tmpfs tmp /tmp
echo "ztvm: kernel $(uname -r), $(nproc) cpus"
if mount -t virtiofs share /mnt/share; then
    echo "ztvm: share: $(cat /mnt/share/hello.txt)"
    echo "written by the guest" > /mnt/share/from-guest.txt
else
    echo "ztvm: no share"
fi
/sbin/agent &
echo "ztvm: ready"
exec sh
