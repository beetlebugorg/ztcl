# The ztcl formula. packaging/homebrew/tap.sh in the ztcl repository
# writes this file for each release.
class Ztcl < Formula
  desc "Experimental sandboxed Tcl interpreter written in Zig"
  homepage "https://github.com/beetlebugorg/ztcl"
  version "@VERSION@"
  license "BSD-2-Clause"

  on_macos do
    on_arm do
      url "@RELEASES@/ztcl-@VERSION@-aarch64-macos.tar.gz"
      sha256 "@SHA_AARCH64_MACOS@"
    end
    on_intel do
      url "@RELEASES@/ztcl-@VERSION@-x86_64-macos.tar.gz"
      sha256 "@SHA_X86_64_MACOS@"
    end
  end

  on_linux do
    on_arm do
      url "@RELEASES@/ztcl-@VERSION@-aarch64-linux-musl.tar.gz"
      sha256 "@SHA_AARCH64_LINUX@"
    end
    on_intel do
      url "@RELEASES@/ztcl-@VERSION@-x86_64-linux-musl.tar.gz"
      sha256 "@SHA_X86_64_LINUX@"
    end
  end

  def install
    bin.install "ztcl"
  end

  test do
    (testpath/"t.tcl").write "puts [expr {6 * 7}]\n"
    assert_equal "42", shell_output("#{bin}/ztcl #{testpath}/t.tcl").strip
  end
end
