# The tests of the module table and the small `package` command.
#
#   zig-out/bin/ztcl tests/stdlib/modules.test
#
# The file needs a build with the test modules (`-Dmod-hello`, on in the
# presets std and full). The child tests run when `interp` exists
# (`--allow interp`).
# SPDX-License-Identifier: BSD-2-Clause

set passed 0
set failed 0
proc test {name script want} {
    set got [uplevel #0 [list catch $script ::res]]
    set got [list $got $::res]
    if {$got eq $want} {
        incr ::passed
    } else {
        incr ::failed
        puts "FAIL $name\n  got:  $got\n  want: $want"
    }
}

test names-1 {
    set n [package names]
    list [expr {"ztcl::hello" in $n}] [expr {"hello" in $n}] [expr {"ztcl::hellonet" in $n}]
} {0 {1 1 1}}

test present-1 {package present ztcl::hello} {1 {package ztcl::hello is not present}}

test versions-1 {package versions ztcl::hello} {0 1.0}
test versions-2 {package versions hello} {0 0.9}

# The old name zt:: works until v0.4.0-beta.
test oldname-1 {
    list [package require zt::hello] [zt::hello greet a] [ztcl::hello greet b] [zt::hello::greet c] [package versions zt::hellonet]
} {0 {1.0 {hello, a} {hello, b} {hello, c} 1.0}}

test require-1 {package require ztcl::hello} {0 1.0}
test require-2 {set ::ztcl::hello::installs} {0 1}
test require-3 {ztcl::hello greet ana} {0 {hello, ana}}

test require-4 {
    list [package require ztcl::hello] [package require ztcl::hello 1] $::ztcl::hello::installs
} {0 {1.0 1.0 1}}

test alias-1 {
    list [package require hello] $::ztcl::hello::installs [hello bob]
} {0 {0.9 1 {hello, bob}}}

test alias-2 {
    list [package require hello] [package present hello] $::ztcl::hello::installs
} {0 {0.9 0.9 1}}

test require-5 {package require ztcl::hello 2} {1 {version conflict for package "ztcl::hello": have 1.0, need 2}}

test caps-1 {package require ztcl::hellonet} {1 {module "ztcl::hellonet" needs the capability socket}}
test caps-2 {
    catch {package require ztcl::hellonet} m o
    dict get $o -errorcode
} {0 {ZT PACKAGE CAPABILITY socket}}
test caps-3 {expr {"ztcl::hellonet" in [package names]}} {0 1}

test provide-1 {
    package provide mine 2.1
    list [package present mine] [package require mine 2]
} {0 {2.1 2.1}}

test small-1 {package ifneeded a 1 {set x 1}} {1 {bad option "ifneeded": must be names, present, provide, require, or versions}}
test small-2 {package req ztcl::hello} {0 1.0}

if {[llength [info commands interp]]} {
    test child-1 {
        interp create c
        set r [list [c eval {info commands ztcl::hello*}] [c eval {package require ztcl::hello}]]
        lappend r [c eval {set ::ztcl::hello::installs}]
        interp delete c
        set r
    } {0 {{} 1.0 1}}
    test child-2 {
        interp create -safe s
        set r [list [s eval {package require ztcl::hello}] [s eval {ztcl::hello greet x}]]
        lappend r [catch {s eval {package require ztcl::hellonet}} m] $m
        interp delete s
        set r
    } {0 {1.0 {hello, x} 1 {module "ztcl::hellonet" needs the capability socket}}}
}

puts "modules.test: pass $passed fail $failed"
if {$failed} {error "$failed tests failed"}
