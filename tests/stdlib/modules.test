# The tests of the module table and the small `package` command.
#
#   zig-out/bin/ztcl tests/stdlib/modules.test
#
# The file needs a build with the test modules (`-Dmod-hello`, on in the
# presets std and full). The child tests run when `interp` exists
# (`--allow interp`).
# SPDX-License-Identifier: BSD-2-Clause

set passed 0
set failed 0
proc test {name script want} {
    set got [uplevel #0 [list catch $script ::res]]
    set got [list $got $::res]
    if {$got eq $want} {
        incr ::passed
    } else {
        incr ::failed
        puts "FAIL $name\n  got:  $got\n  want: $want"
    }
}

test names-1 {
    set n [package names]
    list [expr {"zt::hello" in $n}] [expr {"hello" in $n}] [expr {"zt::hellonet" in $n}]
} {0 {1 1 1}}

test present-1 {package present zt::hello} {1 {package zt::hello is not present}}

test versions-1 {package versions zt::hello} {0 1.0}
test versions-2 {package versions hello} {0 0.9}

test require-1 {package require zt::hello} {0 1.0}
test require-2 {set ::zt::hello::installs} {0 1}
test require-3 {zt::hello greet ana} {0 {hello, ana}}

test require-4 {
    list [package require zt::hello] [package require zt::hello 1] $::zt::hello::installs
} {0 {1.0 1.0 1}}

test alias-1 {
    list [package require hello] $::zt::hello::installs [hello bob]
} {0 {0.9 1 {hello, bob}}}

test alias-2 {
    list [package require hello] [package present hello] $::zt::hello::installs
} {0 {0.9 0.9 1}}

test require-5 {package require zt::hello 2} {1 {version conflict for package "zt::hello": have 1.0, need 2}}

test caps-1 {package require zt::hellonet} {1 {module "zt::hellonet" needs the capability socket}}
test caps-2 {
    catch {package require zt::hellonet} m o
    dict get $o -errorcode
} {0 {ZT PACKAGE CAPABILITY socket}}
test caps-3 {expr {"zt::hellonet" in [package names]}} {0 1}

test provide-1 {
    package provide mine 2.1
    list [package present mine] [package require mine 2]
} {0 {2.1 2.1}}

test small-1 {package ifneeded a 1 {set x 1}} {1 {bad option "ifneeded": must be names, present, provide, require, or versions}}
test small-2 {package req zt::hello} {0 1.0}

if {[llength [info commands interp]]} {
    test child-1 {
        interp create c
        set r [list [c eval {info commands zt::hello*}] [c eval {package require zt::hello}]]
        lappend r [c eval {set ::zt::hello::installs}]
        interp delete c
        set r
    } {0 {{} 1.0 1}}
    test child-2 {
        interp create -safe s
        set r [list [s eval {package require zt::hello}] [s eval {zt::hello greet x}]]
        lappend r [catch {s eval {package require zt::hellonet}} m] $m
        interp delete s
        set r
    } {0 {1.0 {hello, x} 1 {module "zt::hellonet" needs the capability socket}}}
}

puts "modules.test: pass $passed fail $failed"
if {$failed} {error "$failed tests failed"}
